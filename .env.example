# Shared secret required in the "Authorization: Bearer <token>" header on /mcp.
# Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=change-me

# Port the HTTP transport listens on, inside and outside the container.
PORT=3456

# Only needed if you run the optional cloudflared service in
# docker-compose.yml to expose the server at a public HTTPS hostname.
# Get this by creating a tunnel in the Cloudflare Zero Trust dashboard
# (Networks > Tunnels > Create a tunnel > Cloudflared connector).
CLOUDFLARE_TUNNEL_TOKEN=
