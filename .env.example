# Shared secret required in the "Authorization: Bearer <token>" header on /mcp.
# Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=change-me

# Port the HTTP transport listens on, inside and outside the container.
PORT=3456

# Public HTTPS origin the container is reachable at. Setting this turns on the
# OAuth authorization server, which Claude.ai and the mobile apps require.
# Leave it empty to run with the static bearer token only.
MCP_PUBLIC_URL=

# Passphrase for the OAuth login page. Defaults to MCP_AUTH_TOKEN when unset.
MCP_OAUTH_PASSPHRASE=
