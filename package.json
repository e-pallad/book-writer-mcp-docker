{
  "name": "book-writer-mcp",
  "version": "1.0.0",
  "description": "MCP server for AI-assisted book and manuscript writing",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run build:stdio && npm run build:http",
    "build:stdio": "esbuild src/index.ts --bundle --platform=node --target=node18 --outfile=dist/index.js --format=cjs --external:@modelcontextprotocol/sdk",
    "build:http": "esbuild src/http-server.ts --bundle --platform=node --target=node18 --outfile=dist/http-server.js --format=cjs --external:@modelcontextprotocol/sdk",
    "dev": "ts-node src/index.ts",
    "dev:http": "ts-node src/http-server.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/http-server.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "build:test": "esbuild $(find src -name '*.ts') --outdir=dist-tsc --platform=node --target=node18 --format=cjs --log-level=warning",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "pretest": "npm run build && npm run build:test",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "docx": "^8.0.0",
    "express": "^5.0.0",
    "jszip": "^3.10.1",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0",
    "@types/express": "^5.0.0"
  },
  "keywords": [
    "mcp",
    "book-writing",
    "manuscript",
    "claude",
    "ai-writing"
  ],
  "license": "MIT"
}
